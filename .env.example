# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
# SOMENTE servidor. Nunca exponha no navegador nem use prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
# URL publica do site (usada nos e-mails de recuperacao de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Modo demonstracao: o site abre sem login, entrando automaticamente como "Jogador Demo"
# (e com o seletor "Modo admin" visivel). Use "false" em um ambiente real com clientes.
DEMO_MODE=true
